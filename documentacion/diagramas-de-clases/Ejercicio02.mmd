classDiagram
    class Socio {
        +int Id
        +string Nombre
    }
    class Cuenta {
        <<abstract>>
        +int Numero
        +int SocioId
        +decimal Saldo
        +bool Activa
        +DateOnly Apertura
        +PermiteSaldo(decimal) bool
        +InteresMensual() decimal
    }
    class CuentaAhorro
    class CuentaCorriente
    class Movimiento {
        +int Id
        +int CuentaNumero
        +DateOnly Fecha
        +string Tipo
        +decimal Monto
        +decimal SaldoPosterior
        +string TransferenciaId
    }
    class DatosCooperativa
    class Cooperativa {
        +AgregarSocio()
        +AbrirCuenta()
        +Depositar()
        +Retirar()
        +Transferir()
        +AplicarIntereses()
        +CerrarCuenta()
        +Consultar()
    }
    class ArchivoJson {
        +Cargar()
        +Guardar()
        +Copiar()
    }
    class ReportesCooperativa {
        +EstadoCuenta()
        +InteresesMes()
        +Sobregiros()
        +Totales()
        +Auditar()
    }
    Cuenta <|-- CuentaAhorro
    Cuenta <|-- CuentaCorriente
    Socio "1" --> "0..*" Cuenta : posee
    Cuenta "1" --> "0..*" Movimiento : registra
    DatosCooperativa o-- Socio
    DatosCooperativa o-- Cuenta
    DatosCooperativa o-- Movimiento
    Cooperativa --> ArchivoJson
    Cooperativa --> DatosCooperativa
    ReportesCooperativa ..> DatosCooperativa
